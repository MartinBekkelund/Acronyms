<?xml version="1.0"?>
<ruleset name="Acronyms">
	<description>Coding standards for the Acronyms plugin.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.7"/>

	<rule ref="WordPress"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="acronym-tooltips"/>
			</property>
		</properties>
	</rule>

	<!-- DOMDocument properties (nodeValue, parentNode, ...) are PHP's own names. -->
	<rule ref="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase">
		<exclude-pattern>/includes/class-acronyms-filter\.php</exclude-pattern>
	</rule>

	<!-- The plugin stores acronyms in its own table, so direct queries are expected there.
	     The front-end list is cached with a transient in get_acronyms_for_replacement(). -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>/includes/class-acronyms-db\.php</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="acronyms"/>
			</property>
		</properties>
	</rule>
</ruleset>
